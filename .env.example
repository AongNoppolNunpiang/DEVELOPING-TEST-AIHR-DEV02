# Copy to .env and replace the password with the local database secret.
DATABASE_URL="postgresql://aihr_app:<NEW_LOCAL_PASSWORD>@127.0.0.1:<VERIFIED_FREE_HOST_PORT>/aihr_dev02?schema=public"

# Demo authentication: placeholders only. Set real values privately on the server.
# Password: at least 16 UTF-8 bytes; independent random signing secret: at least 32 bytes.
DEMO_PASSWORD="<REPLACE_WITH_STRONG_SHARED_DEMO_PASSWORD>"
DEMO_SESSION_SECRET="<REPLACE_WITH_INDEPENDENT_RANDOM_SIGNING_SECRET>"
# Exact origin with no trailing slash. Production must use HTTPS.
DEMO_APP_ORIGIN="https://<YOUR_DEMO_HOST>"
DEMO_SESSION_TTL_SECONDS="7200"
